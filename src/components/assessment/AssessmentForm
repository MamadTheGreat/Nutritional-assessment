import { Loader2, Sparkles } from "lucide-react";
import { toast } from "sonner";
import AnthropometryGroup from "@/components/assessment/groups/AnthropometryGroup";
import ClinicalGroup from "@/components/assessment/groups/ClinicalGroup";
import IdentityGroup from "@/components/assessment/groups/IdentityGroup";
import LabsGroup from "@/components/assessment/groups/LabsGroup";
import NutritionGroup from "@/components/assessment/groups/NutritionGroup";
import ScreeningGroup from "@/components/assessment/groups/ScreeningGroup";
import DictateButton from "@/components/assessment/DictateButton";
import { speechToNumber } from "@/lib/faNumbers";

const UNSUPPORTED = "دیکته گفتاری در این مرورگر پشتیبانی نمی‌شود";

export default function AssessmentForm({ value, setField, onSubmit, busy, protocols, patients }) {
  const appendText = (key) => (text) => {
    if (text === "__unsupported__") return toast.error(UNSUPPORTED);
    const glue = /[\u0600-\u06FF]/.test(text) ? "، " : " ";
    setField(key, [value[key], text].filter(Boolean).join(glue));
  };

  const dictateNumber = (key) => (text) => {
    if (text === "__unsupported__") return toast.error(UNSUPPORTED);
    const parsed = speechToNumber(text);
    if (parsed == null) return toast.error("عدد از صدا تشخیص داده نشد؛ دوباره بگویید");
    setField(key, parsed);
  };

  const mic = (key) => <DictateButton onText={appendText(key)} />;
  const micNum = (key) => <DictateButton onText={dictateNumber(key)} compact />;

  return (
    <form
      onSubmit={(e) => {
        e.preventDefault();
        onSubmit();
      }}
      className="space-y-3"
    >
      <IdentityGroup value={value} setField={setField} mic={mic} micNum={micNum} patients={patients} />
      <AnthropometryGroup value={value} setField={setField} micNum={micNum} />
      <NutritionGroup value={value} setField={setField} mic={mic} />
      <ClinicalGroup value={value} setField={setField} mic={mic} />
      <ScreeningGroup value={value} setField={setField} protocols={protocols} />
      <LabsGroup value={value} setField={setField} mic={mic} onExtracted={appendText("abnormal_labs")} />

      <button
        type="submit"
        disabled={busy || !value.weight || !value.height}
        className="sticky bottom-20 flex w-full items-center justify-center gap-2 rounded-xl bg-primary py-3 text-[13px] font-semibold text-primary-foreground shadow-sm transition-opacity disabled:opacity-40 md:bottom-4"
      >
        {busy ? <Loader2 className="h-4 w-4 animate-spin" /> : <Sparkles className="h-4 w-4" />}
        {busy ? "در حال محاسبه…" : "محاسبه ارزیابی"}
      </button>
    </form>
  );
}
